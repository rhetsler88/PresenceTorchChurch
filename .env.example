# Firebase / app (see src/lib/firebase.js for defaults)
# VITE_* vars are exposed to the client.

# Agora — real-time live PTT (WebRTC). Required for low-latency push-to-talk.
# Create an project at https://console.agora.io and paste the App ID here.
# Server token minting uses Cloud Function getAgoraToken (secrets AGORA_APP_ID + AGORA_APP_CERTIFICATE).
VITE_AGORA_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
# Web OAuth client ID (Google Cloud → Credentials → Web client). Used for transcript export to Google Docs.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Public app URL (used for admin links and redirects). Production default: https://app.presencetorch.net
VITE_WEB_APP_URL=
