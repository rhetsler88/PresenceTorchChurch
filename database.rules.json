{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "channels": {
          "$channelId": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['state', 'channel_id', 'user_id']) && newData.child('state').val() == 'online' && newData.child('user_id').val() == $uid && newData.child('channel_id').val() == $channelId"
          }
        }
      }
    }
  }
}
