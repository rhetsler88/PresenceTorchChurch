rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && userDoc().exists;
    }

    function role() {
      return userDoc().data.get('role', '');
    }

    function isSuperAdmin() {
      return userExists() && role() == 'super_admin';
    }

    function isAdmin() {
      return userExists() && role() == 'admin';
    }

    function isDirector() {
      return userExists() && role() == 'director';
    }

    function isAdminOrDirector() {
      return isAdmin() || isDirector() || isSuperAdmin();
    }

    function isPlatformAdmin() {
      return isSuperAdmin() || isAdmin();
    }

    function isPlatformAdminFromToken() {
      return isSignedIn() && (
        tokenRole() == 'super_admin'
        || tokenRole() == 'admin'
      );
    }

    function isMonitor() {
      return userExists() && (
        userDoc().data.get('is_monitor', false) == true || role() == 'monitor'
      );
    }

    // Role from Auth custom claims — required for collection queries (get(users/uid).role breaks lists).
    function tokenRole() {
      return request.auth.token.get('role', '');
    }

    function isElevatedFromToken() {
      return isSignedIn() && (
        tokenRole() == 'super_admin'
        || tokenRole() == 'admin'
        || tokenRole() == 'director'
        || tokenRole() == 'monitor'
        || request.auth.token.get('is_monitor', false) == true
      );
    }

    function canViewAllVoiceMessages() {
      return isElevatedFromToken() || isSuperAdmin() || isAdmin() || isDirector() || isMonitor();
    }

    function memberChannelIds() {
      let channels = userDoc().data.get('member_of_channels', []);
      return channels is list ? channels : [];
    }

    function isMemberOfChannelId(channelId) {
      return isSignedIn() && memberChannelIds().hasAny([channelId]);
    }

    function channelDoc(channelId) {
      return get(/databases/$(database)/documents/channels/$(channelId));
    }

    function channelExistsPath(channelId) {
      return channelDoc(channelId).exists;
    }

    function isListedOnChannel(list) {
      return list.hasAny([request.auth.uid, request.auth.token.email]);
    }

    function channelMembers(channelId) {
      return channelDoc(channelId).data.get('members', []);
    }

    function channelNotificationMembers(channelId) {
      return channelDoc(channelId).data.get('notification_members', []);
    }

    function isChannelTalkMember(channelId) {
      return isSuperAdmin()
        || isMemberOfChannelId(channelId)
        || (channelExistsPath(channelId) && isListedOnChannel(channelMembers(channelId)));
    }

    function isChannelAlertRecipient(channelId) {
      return isChannelTalkMember(channelId)
        || (channelExistsPath(channelId) && isListedOnChannel(channelNotificationMembers(channelId)));
    }

    function userDirectedChannels() {
      return userDoc().data.get('directed_channels', []);
    }

    function isDirectorForChannel(channelId) {
      return isDirector()
        && channelExistsPath(channelId)
        && (
          userDirectedChannels().size() == 0
          || userDirectedChannels().hasAny([channelId])
        );
    }

    function channelOrganization(channelId) {
      return channelDoc(channelId).data.get('organization', '');
    }

    // Match client userUtils: empty/missing channel organization => visible to scoped roles.
    function channelOrgMatchesUser(channelId) {
      return !userHasOrganizationConstraint()
        || channelOrganization(channelId).size() == 0
        || channelOrganization(channelId) == userOrganization();
    }

    function isMonitorForChannel(channelId) {
      return isMonitor()
        && channelExistsPath(channelId)
        && channelOrgMatchesUser(channelId);
    }

    // PTT / voice create — members plus roles that can monitor/respond on a channel.
    function canSendOnChannel(channelId) {
      return isElevatedFromToken()
        || isPlatformAdmin()
        || isChannelTalkMember(channelId)
        || isOrgAdminForChannel(channelId)
        || isDirectorForChannel(channelId)
        || isMonitorForChannel(channelId);
    }

    function userOrganization() {
      return userDoc().data.get('organization', '');
    }

    // Match client canAccessChannel: empty/missing organization => all org channels.
    function userHasOrganizationConstraint() {
      return userOrganization() is string && userOrganization().size() > 0;
    }

    function isOrgAdminForChannel(channelId) {
      return isAdmin()
        && channelExistsPath(channelId)
        && channelOrgMatchesUser(channelId);
    }

    function channelIdOnResource() {
      return resource.data.channel_id is string
        && resource.data.channel_id.size() > 0;
    }

    function channelIdOnRequest() {
      return request.resource.data.channel_id is string
        && request.resource.data.channel_id.size() > 0;
    }

    function userSelfUpdateForbiddenKeys() {
      return resource.data.get('onboarded', false) == true
        ? [
            'role',
            'is_monitor',
            'receives_staff_alerts',
            'pending_staff_alerts',
            'daily_code_verified_date',
            'daily_code_failed_attempts',
            'daily_code_locked_until',
          ]
        : [
            'role',
            'is_monitor',
            'receives_staff_alerts',
            'daily_code_verified_date',
            'daily_code_failed_attempts',
            'daily_code_locked_until',
          ];
    }

    function isSelfJoinRequest(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data.get(field, []).hasAll(resource.data.get(field, []))
        && request.resource.data.get(field, []).hasAny([request.auth.uid])
        && !resource.data.get(field, []).hasAny([request.auth.uid]);
    }

    function isSelfChannelRequest() {
      return isSelfJoinRequest('pending_members')
        || isSelfJoinRequest('pending_notification_members');
    }

    function isProtectionLevelOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protection_level']);
    }

    // Admin tab: role changes, staff alerts, directed_channels (matches client isPlatformAdmin).
    function canManageUsers() {
      return isPlatformAdmin() || isPlatformAdminFromToken();
    }

    // Admin tab: approve/reject channel join requests (matches client isPlatformAdmin + directors).
    function canManageChannelMembership(channelId) {
      return isPlatformAdmin()
        || isPlatformAdminFromToken()
        || isDirectorForChannel(channelId);
    }

    function systemDailyCodeDateKey() {
      let dailyCodeDoc = get(/databases/$(database)/documents/system/dailyCode);
      return dailyCodeDoc.exists ? dailyCodeDoc.data.get('dateKey', '') : '';
    }

    function bypassesDailyCodeGate() {
      return isSuperAdmin() || isAdmin() || isDirector();
    }

    function isDailyCodeVerifiedForSession() {
      let userDate = userDoc().data.get('daily_code_verified_date', '');
      let systemDate = systemDailyCodeDateKey();
      let validUntil = userDoc().data.get('daily_code_valid_until', timestamp);
      return bypassesDailyCodeGate()
        || (validUntil != null && request.time < validUntil)
        || (userDate != '' && userDate == systemDate)
        || (userDate != '' && systemDate == '');
    }

    function canUsePttWhenDailyCodeRequired() {
      return isElevatedFromToken() || isDailyCodeVerifiedForSession();
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('onboarded', false) == false;

      allow update: if isSignedIn() && (
        canManageUsers()
        || (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(userSelfUpdateForbiddenKeys())
        )
      );

      allow delete: if isPlatformAdmin() || isPlatformAdminFromToken();
    }

    // ── Organizations ──────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Channels ───────────────────────────────────────────────────────
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isAdminOrDirector();

      allow update: if isSignedIn() && (
        canManageChannelMembership(channelId)
        || isSelfChannelRequest()
        || isProtectionLevelOnlyUpdate()
      );

      allow delete: if isPlatformAdmin() || isPlatformAdminFromToken();
    }
    match /voiceMessages/{messageId} {
      allow read: if isElevatedFromToken();
      allow read: if channelIdOnResource()
        && isChannelTalkMember(resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired();

      allow create: if isSignedIn()
        && channelIdOnRequest()
        && canSendOnChannel(request.resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired()
        && request.resource.data.get('created_by_id', request.auth.uid) == request.auth.uid;

      allow update: if isElevatedFromToken();
      allow update: if channelIdOnResource()
        && isChannelTalkMember(resource.data.channel_id);
      allow update: if isSignedIn()
        && channelIdOnResource()
        && isChannelTalkMember(resource.data.channel_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transcript', 'is_transcribed']);

      allow delete: if isSignedIn() && isAdminOrDirector();
    }

    match /pttSignals/{signalId} {
      allow read: if isElevatedFromToken();
      allow read: if channelIdOnResource()
        && isChannelTalkMember(resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired();

      allow create: if isSignedIn()
        && channelIdOnRequest()
        && canSendOnChannel(request.resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired()
        && request.resource.data.sender_id == request.auth.uid;

      allow delete: if isSignedIn()
        && channelIdOnResource()
        && (
          resource.data.sender_id == request.auth.uid
          || isAdminOrDirector()
        );

      allow update: if false;
    }

    match /audioChunks/{chunkId} {
      allow read: if isElevatedFromToken();
      allow read: if channelIdOnResource()
        && isChannelTalkMember(resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired();

      allow create: if isSignedIn()
        && channelIdOnRequest()
        && canSendOnChannel(request.resource.data.channel_id)
        && canUsePttWhenDailyCodeRequired()
        && request.resource.data.sender_id == request.auth.uid;

      allow delete: if isSignedIn() && isAdminOrDirector();

      allow update: if false;
    }

    match /contacts/{contactId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /accessRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isPlatformAdmin() || isPlatformAdminFromToken();
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /dailyCodes/{orgId} {
      allow read, write: if false;
    }

    match /alertLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
  }
}
