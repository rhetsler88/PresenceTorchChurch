{
  "name": "base44-app",
  "private": true,
  "version": "1.0.54",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "patch-package",
    "test": "node --test src/lib/blePttConstants.test.js src/lib/monitorRecentMessages.test.js src/lib/pttLimits.test.js src/lib/pttClearToneDedup.test.js src/lib/flipScreen.test.js src/lib/pttAccessCache.test.js src/lib/userUtils.test.js src/lib/iosSignInConfig.test.js src/lib/biometricAuth.test.js src/lib/presence.test.js src/lib/textMessageNotifications.test.js src/lib/livePtt.test.js src/lib/agoraRemote.test.js src/lib/storePreview.test.js src/lib/appStoreScreenshotSpec.test.js src/lib/appStoreScreenshots.test.js scripts/lib/appStoreConnect.test.mjs scripts/uploadAppStoreScreenshots.test.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "setup:vapid": "node scripts/setup-firebase-vapid.mjs",
    "seed": "node scripts/seed-firestore.mjs",
    "create:play-reviewer": "node scripts/create-play-reviewer.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "export:app-store-screenshots": "node scripts/export-app-store-screenshots.mjs",
    "export:app-store-signin-png": "node scripts/export-app-store-signin-png.mjs",
    "capture:app-store-login": "node scripts/capture-app-store-login.mjs",
    "check:app-store-screenshots": "node scripts/check-app-store-screenshots.mjs",
    "upload:app-store-screenshots": "node scripts/upload-app-store-screenshots.mjs",
    "channels:list": "node scripts/list-channels.mjs",
    "channels:delete-excess": "node scripts/delete-channel.mjs --excess",
    "dev:admin": "npm run dev --prefix admin",
    "build:admin": "npm run build --prefix admin",
    "setup:domains": "node scripts/add-firebase-domains.mjs",
    "setup:email-auth": "node scripts/enable-email-auth.mjs",
    "setup:storage-cors": "gcloud storage buckets update gs://presence-torch-church.firebasestorage.app --cors-file=storage.cors.json",
    "deploy:functions": "npx firebase-tools deploy --only functions --project presence-torch-church",
    "deploy:delete-account": "npx firebase-tools deploy --only functions:deleteUserAccount --project presence-torch-church",
    "deploy:admin-delete-user": "npx firebase-tools deploy --only functions:adminDeleteUser --project presence-torch-church",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes,storage,database --project presence-torch-church",
    "cap:sync": "npm run build && npx cap sync && node scripts/register-ios-local-plugins.mjs",
    "cap:sync:android": "node scripts/sync-recaptcha-env.mjs && npm run cap:sync",
    "cap:icons": "node scripts/generate-capacitor-assets.mjs",
    "cap:sha1": "node scripts/print-android-sha1.mjs",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-native-biometric": "^8.6.2",
    "@hello-pangea/dnd": "^17.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.84.1",
    "agora-rtc-sdk-ng": "^4.24.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "denoise-voice-clarity": "^0.2.2",
    "firebase": "^12.16.0",
    "framer-motion": "^11.16.4",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-router-dom": "^6.26.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "firebase-admin": "^13.4.0",
    "globals": "^15.14.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
