rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && userDoc().data.keys().hasAny(['email', 'role']);
    }

    function channelOrganization(channelId) {
      return channelDoc(channelId).data.get('organization', '');
    }

    function channelOrgMatchesUser(channelId) {
      return !userHasOrganizationConstraint()
        || channelOrganization(channelId).size() == 0
        || channelOrganization(channelId) == userOrganization();
    }

    function role() {
      return userDoc().data.get('role', '');
    }

    function isSuperAdmin() {
      return userExists() && role() == 'super_admin';
    }

    function isAdmin() {
      return userExists() && role() == 'admin';
    }

    function isDirector() {
      return userExists() && role() == 'director';
    }

    function isPlatformAdmin() {
      return isSuperAdmin() || isAdmin();
    }

    function isMonitor() {
      return userExists() && (
        userDoc().data.get('is_monitor', false) == true || role() == 'monitor'
      );
    }

    function tokenRole() {
      return request.auth.token.get('role', '');
    }

    function isElevatedFromToken() {
      return isSignedIn() && (
        tokenRole() == 'super_admin'
        || tokenRole() == 'admin'
        || tokenRole() == 'director'
        || tokenRole() == 'monitor'
        || request.auth.token.get('is_monitor', false) == true
      );
    }

    function canViewAllVoiceMessages() {
      return isElevatedFromToken() || isPlatformAdmin() || isDirector() || isMonitor();
    }

    function memberChannelIds() {
      let channels = userDoc().data.get('member_of_channels', []);
      return channels is list ? channels : [];
    }

    function isUserMemberOfChannel(channelId) {
      return isSignedIn() && memberChannelIds().hasAny([channelId]);
    }

    function channelDoc(channelId) {
      return firestore.get(/databases/(default)/documents/channels/$(channelId));
    }

    function channelExists(channelId) {
      return channelDoc(channelId).data.keys().hasAny(['name', 'members']);
    }

    function isListedOnChannel(list) {
      return list.hasAny([request.auth.uid, request.auth.token.email]);
    }

    function channelMembers(channelId) {
      return channelDoc(channelId).data.get('members', []);
    }

    function channelNotificationMembers(channelId) {
      return channelDoc(channelId).data.get('notification_members', []);
    }

    function userMemberChannels() {
      return memberChannelIds();
    }

    function isChannelTalkMember(channelId) {
      return isSuperAdmin()
        || isUserMemberOfChannel(channelId)
        || (channelExists(channelId) && isListedOnChannel(channelMembers(channelId)));
    }

    function isChannelAlertRecipient(channelId) {
      return isChannelTalkMember(channelId)
        || (channelExists(channelId) && isListedOnChannel(channelNotificationMembers(channelId)));
    }

    function userOrganization() {
      return userDoc().data.get('organization', '');
    }

    function userHasOrganizationConstraint() {
      return userOrganization() is string && userOrganization().size() > 0;
    }

    function userDirectedChannels() {
      return userDoc().data.get('directed_channels', []);
    }

    function isDirectorForChannel(channelId) {
      return isDirector()
        && channelExists(channelId)
        && (
          userDirectedChannels().size() == 0
          || userDirectedChannels().hasAny([channelId])
        );
    }

    function isMonitorForChannel(channelId) {
      return isMonitor()
        && channelExists(channelId)
        && channelOrgMatchesUser(channelId);
    }

    function isOrgAdminForChannel(channelId) {
      return isAdmin()
        && channelExists(channelId)
        && channelOrgMatchesUser(channelId);
    }

    // Match Firestore canSendOnChannel — PTT upload + voice message storage.
    function canSendOnChannel(channelId) {
      return isElevatedFromToken()
        || isPlatformAdmin()
        || isChannelTalkMember(channelId)
        || isOrgAdminForChannel(channelId)
        || isDirectorForChannel(channelId)
        || isMonitorForChannel(channelId);
    }

    function canAccessChannelAudio(channelId) {
      // Anyone who can transmit can also read/play (incl. getDownloadURL right after upload).
      return canSendOnChannel(channelId) || canViewAllVoiceMessages();
    }

    // Legacy relay + message paths (pre channel-scoped layout)
    match /audio/public/chunks/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /audio/private/messages/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Live relay chunks scoped by channel
    match /audio/public/{channelId}/{allPaths=**} {
      allow read: if isSignedIn() && canAccessChannelAudio(channelId);
      allow write: if isSignedIn()
        && canSendOnChannel(channelId)
        && isAudio()
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Recorded voice messages scoped by channel
    match /audio/private/{channelId}/{allPaths=**} {
      allow read: if isSignedIn() && canAccessChannelAudio(channelId);
      allow write: if isSignedIn()
        && canSendOnChannel(channelId)
        && isAudio()
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
